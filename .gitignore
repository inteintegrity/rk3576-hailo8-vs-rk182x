# Python
__pycache__/
*.pyc
*.pyo

# per-backend virtual environments (created by scripts/install-*.sh on the board)
.venvs/

# what a run writes (kept out of git; the shipped records live in results/)
out/
annotated.mp4
run.log

# the sample clip ships on purpose; anything else dropped into video/ does not
video/*
!video/test.mp4

# the two published comparison videos are hosted on the SenseCraft CDN, not in git,
# because they are 64 MB of derived media (see results/README.md)
results/clips/

# conversion intermediates (produced by the vendor toolchains, not part of the delivery)
*.onnx
*.pt
*.har
tmp/
scratch/
